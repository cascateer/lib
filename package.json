{
  "name": "@cascateer/lib",
  "version": "1.0.93",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cascateer/lib.git"
  },
  "scripts": {
    "semver-patch": "npm version patch && git push origin main --tags",
    "update": "npm cache clean --force && npx npm-check-updates -u --format time && npm i",
    "test": "vitest",
    "build": "tsc"
  },
  "exports": {
    ".": {
      "import": "./src/index.js",
      "require": "./src/index.js",
      "types": "./dist/index.d.ts"
    },
    "./observable": {
      "import": "./src/observable/index.js",
      "require": "./src/observable/index.js",
      "types": "./src/observable/index.d.ts"
    },
    "./promise": {
      "import": "./src/promise/index.js",
      "require": "./src/promise/index.js",
      "types": "./src/promise/index.d.ts"
    },
    "./math": {
      "import": "./src/math/index.js",
      "require": "./src/math/index.js",
      "types": "./src/math/index.d.ts"
    }
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "lodash": "^4.18.1",
    "rxjs": "^7.8.2",
    "utility-types": "^3.11.0",
    "uuid": "^14.0.1"
  },
  "devDependencies": {
    "@types/lodash": "^4.17.24",
    "@types/node": "^26.1.2",
    "vitest": "^4.1.10"
  }
}
