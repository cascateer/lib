{
  "compilerOptions": {
    "target": "es2016",
    "module": "esnext",
    "types": ["node"],
    "lib": ["ESNext", "dom", "WebWorker"],
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "noUncheckedIndexedAccess": true,
    "rootDir": "./src",
    "outDir": "./dist",
    "declaration": true
  }
}
